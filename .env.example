# FlashGuard Environment Configuration

# FastAPI Backend Base URL (Configurable target backend)
# In development, defaults to http://localhost:8000
VITE_API_BASE_URL="http://localhost:8000"

# Default Demo Mode ('true' to load local simulation datasets, 'false' for live API)
VITE_DEFAULT_DEMO_MODE="true"

# Request timeout in milliseconds for live API calls
VITE_API_TIMEOUT_MS="5000"

# Port for frontend host server (default 3000)
PORT="3000"
